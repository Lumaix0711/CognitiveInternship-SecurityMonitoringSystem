# 本地配置模板。复制为 .env 后填入真实值，.env 不会被提交。
#   cp .env.example .env
# 生成随机密码：openssl rand -base64 24 | tr -d '/+=' | cut -c1-28

# MySQL root 密码（compose 强制要求，缺省会直接报错退出）
MYSQL_ROOT_PASSWORD=change_me_generate_a_random_one

# 平台 8888 端口的 Basic Auth 账号
APP_AUTH_USER=security

# 平台 8888 端口的 Basic Auth 密码
APP_AUTH_PASSWORD=change_me_generate_a_random_one
